# 监听端口
PORT=8787
# 监听地址；部署时可用 0.0.0.0
HOST=127.0.0.1
# 签名密钥：部署时务必替换为随机长字符串
IMPORT_SIGNING_SECRET=change-me-to-a-long-random-string
# 前端静态目录（默认 ../../web/dist）
# STATIC_DIR=/srv/my-popmart/web/dist

# 默认共享云端数据。Vercel Marketplace 连接 Neon 后自动注入 DATABASE_URL。
# 只在后端配置，不要添加 VITE_ 前缀，也不要提交真实密码。
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# 同时兼容 POSTGRES_URL / NEON_DATABASE_URL。
DATA_MODE=shared
# 多个域名使用同一个数据库和空间时共享数据。
SHARED_SPACE_ID=public
# 保留旧的纯本机模式：DATA_MODE=local
