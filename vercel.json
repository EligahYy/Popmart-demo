{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "import-server": {
      "root": "apps/import-server",
      "framework": "fastify",
      "entrypoint": "dist/server.js",
      "outputDirectory": "dist",
      "functions": {
        "dist/server.js": {
          "includeFiles": ["data/aliases.zh.json"]
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "import-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
